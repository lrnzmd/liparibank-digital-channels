    "autocannon": "^8.0.0",
    "eslint": "^10.7.0",
    "fastify": "^5.12.7",
    "jest": "^30.5.2",
    "prettier": "^3.9.5",
    "prisma": "^5.15.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.1",
